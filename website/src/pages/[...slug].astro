---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import SkillReader from '../components/SkillReader.astro';
import GettingStarted from '../components/GettingStarted.astro';
import HerdrSetup from '../components/HerdrSetup.astro';
import { skills } from '../data/skills';
import { documentTitle, sourceUrl } from '../lib/documentation.mjs';

export async function getStaticPaths() {
  return (await getCollection('documentation')).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'documentation'> }
const { entry } = Astro.props;
const gettingStarted = entry.id === 'docs/getting-started';
const herdrSetup = entry.id === 'docs/herdr';
const routingPrompt = herdrSetup ? entry.body?.match(/```text\n(Enable HolyCow[\s\S]*?)\n```/)?.[1] : '';
if (herdrSetup && !routingPrompt) throw new Error('Missing Herdr setup prompt');
const skill = skills.find(skill => entry.id === `skills/${skill.name}`);
const { Content, headings } = await render(entry);
const related = skill ? (await getCollection('documentation')).filter(item => item.id.startsWith(`skills/${skill.name}/`)) : [];
const title = skill?.name ?? (entry.id === 'docs/getting-started' ? 'Getting started' : documentTitle(entry));
const description = gettingStarted ? 'Install HolyCow, pick a skill, and try your first prompt. A visual quick start for Claude Code, Codex, and Cursor.' : skill?.description ?? `HolyCow documentation: ${title}. Open-source development skills for Claude Code, Codex, and Cursor.`;
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
const source = sourceUrl(entry.filePath ?? 'README.md');
const editSource = skill ? 'https://github.com/NeuralHerd/holycow/blob/main/website/src/data/skill-guides.ts' : source;
---
<Base title={title} description={description} wide>
  {gettingStarted ? <div class="docs-shell quick-start-shell"><Sidebar /><GettingStarted /></div> : <div class="docs-shell">
    <Sidebar />
    <article class="doc-main">
      <div class="doc-breadcrumb"><a href="/">HolyCow</a><span>/</span><span>{skill ? skill.group : 'Documentation'}</span></div>
      {skill ? <>
        <SkillReader skill={skill} />
        <details class="skill-source-disclosure">
          <summary id="skill-instructions"><span>Full agent instructions</span><span class="skill-source-hint">Optional · what your agent reads</span></summary>
          <p class="skill-source-note">The rules behind the skill. You can use it without reading these. <a href={source}>View source ↗</a></p>
          {related.length > 0 && <section class="related-guidance"><h2>Supporting guidance</h2><p>The skill reads these references when the task needs them.</p><ul>{related.map(item => <li><a href={`/${item.id}/`}>{documentTitle(item)} <span aria-hidden="true">↗</span></a></li>)}</ul></section>}
          <div class="prose skill-source"><Content /></div>
        </details>
      </> : herdrSetup ? <HerdrSetup routingPrompt={routingPrompt!}>
        <header class="reference-header"><p class="eyebrow">Documentation</p><p class="source-note">Published from the repository · <a href={source}>View source ↗</a></p></header>
        <div class="prose"><Content /></div>
      </HerdrSetup> : <>
        <header class="reference-header"><p class="eyebrow">{entry.id.startsWith('docs/evaluations/') ? 'Evaluation scenario' : 'Documentation'}</p><p class="source-note">Published from the repository · <a href={source}>View source ↗</a></p></header>
        <div class="prose"><Content /></div>
      </>}
      <div class="doc-feedback"><p>Found something that could be better?</p><a href="https://github.com/NeuralHerd/holycow/issues">Open an issue ↗</a><a href={editSource.replace('/blob/', '/edit/')}>Edit this page ↗</a></div>
    </article>
    <aside class="page-toc" aria-label="On this page"><p class="sidebar-label">On this page</p>
      {skill ? <><a href="#how-it-works">How it works</a><a href="#try-heading">Try an example</a><a href="#skill-instructions">Full instructions</a></> : toc.map(heading => <a class:list={[heading.depth === 3 && 'toc-nested']} href={`#${heading.slug}`}>{heading.text}</a>)}
    </aside>
  </div>}
</Base>
<script>
  function revealInstructions() {
    let id;
    try { id = decodeURIComponent(window.location.hash.slice(1)); } catch { return; }
    const target = document.getElementById(id);
    const disclosure = target?.closest<HTMLDetailsElement>('.skill-source-disclosure, .herdr-reference');
    if (disclosure && !disclosure.open) {
      disclosure.open = true;
      target?.scrollIntoView();
    }
  }
  revealInstructions();
  window.addEventListener('hashchange', revealInstructions);
</script>

<style>
  .quick-start-shell { grid-template-columns: 215px minmax(0, 1fr); max-width: 1360px; }
  .skill-source-disclosure { padding-block: 18px; border-block: 1px solid var(--border); }
  .skill-source-disclosure summary { cursor: pointer; color: var(--ink); font-size: 13px; }
  .skill-source-hint { float: right; font-size: 11px; color: var(--ink-70); }
  .skill-source-note { font-size: 12px; color: var(--ink-70); margin: 22px 0; }
  @media (max-width: 680px) { .skill-source-hint { float: none; display: block; padding-left: 17px; margin-top: 5px; } }
</style>
